	   Р В РЎСљР В РІР‚Сћ Р В Р’В°Р В РЎвЂќР РЋРІР‚С™Р В РЎвЂР В Р вЂ Р В РЎвЂР РЋР вЂљР РЋРЎвЂњР В Р’ВµР РЋРІР‚С™ Р РЋР РЉР РЋРІР‚С›Р РЋРІР‚С›Р В Р’ВµР В РЎвЂќР РЋРІР‚С™Р РЋРІР‚в„–! Р В Р’В­Р РЋРІР‚С›Р РЋРІР‚С›Р В Р’ВµР В РЎвЂќР РЋРІР‚С™Р РЋРІР‚в„– Р В РЎвЂ”Р РЋР вЂљР В РЎвЂР В РЎВР В Р’ВµР В Р вЂ¦Р РЋР РЏР РЋР вЂ№Р РЋРІР‚С™Р РЋР С“Р РЋР РЏ Р РЋРІР‚РЋР В Р’ВµР РЋР вЂљР В Р’ВµР В Р’В· Р В РЎвЂР В Р вЂ¦Р В Р вЂ Р В Р’ВµР В Р вЂ¦Р РЋРІР‚С™Р В Р’В°Р РЋР вЂљР РЋР Р‰."""
	if not artifacts_database.has(artifact_id):
		return false

	if collected_artifacts.has(artifact_id):
		return false

	collected_artifacts.append(artifact_id)
	add_artifact_collected()

	# Р В РЎСљР В РІР‚Сћ Р В РЎвЂ”Р РЋР вЂљР В РЎвЂР В РЎВР В Р’ВµР В Р вЂ¦Р РЋР РЏР В Р’ВµР В РЎВ Р РЋР РЉР РЋРІР‚С›Р РЋРІР‚С›Р В Р’ВµР В РЎвЂќР РЋРІР‚С™Р РЋРІР‚в„– Р В Р’В°Р В Р вЂ Р РЋРІР‚С™Р В РЎвЂўР В РЎВР В Р’В°Р РЋРІР‚С™Р В РЎвЂР РЋРІР‚РЋР В Р’ВµР РЋР С“Р В РЎвЂќР В РЎвЂ!
	# Р В РЎвЂ™Р РЋР вЂљР РЋРІР‚С™Р В Р’ВµР РЋРІР‚С›Р В Р’В°Р В РЎвЂќР РЋРІР‚С™ Р В Р вЂ¦Р РЋРЎвЂњР В Р’В¶Р В Р вЂ¦Р В РЎвЂў Р РЋР РЉР В РЎвЂќР В РЎвЂР В РЎвЂ”Р В РЎвЂР РЋР вЂљР В РЎвЂўР В Р вЂ Р В Р’В°Р РЋРІР‚С™Р РЋР Р‰ Р В Р вЂ  Р РЋР С“Р В Р’В»Р В РЎвЂўР РЋРІР‚С™ Р В РЎвЂР В Р вЂ¦Р В Р вЂ Р В Р’ВµР В Р вЂ¦Р РЋРІР‚С™Р В Р’В°Р РЋР вЂљР РЋР РЏ

	artifact_collected.emit(artifact_id)
	return true


func get_artifact_data(artifact_id: String) -> Dictionary:
	if artifacts_database.has(artifact_id):
		return artifacts_database[artifact_id]
	return {"name": artifact_id, "rarity": "common", "ability": "unknown"}


func get_artifact_rarity(artifact_id: String) -> String:
	if artifacts_database.has(artifact_id):
		return artifacts_database[artifact_id].get("rarity", "common")
	return "common"


func get_artifacts_by_rarity() -> Dictionary:
	var result = {"common": [], "rare": [], "epic": [], "legendary": []}

	for artifact_id in collected_artifacts:
		var rarity = get_artifact_rarity(artifact_id)
		if result.has(rarity):
			result[rarity].append(artifact_id)

	return result


