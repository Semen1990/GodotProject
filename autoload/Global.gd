func register_collected_pickup(object_name: String):
	"""Р В Р’В Р В Р’ВµР В РЎвЂ“Р В РЎвЂР РЋР С“Р РЋРІР‚С™Р РЋР вЂљР В РЎвЂР РЋР вЂљР РЋРЎвЂњР В Р’ВµР РЋРІР‚С™ Р В РЎвЂ”Р В РЎвЂўР В РўвЂР В РЎвЂўР В Р’В±Р РЋР вЂљР В Р’В°Р В Р вЂ¦Р В Р вЂ¦Р РЋРІР‚в„–Р В РІвЂћвЂ“ Р В РЎвЂўР В Р’В±Р РЋР вЂ°Р В Р’ВµР В РЎвЂќР РЋРІР‚С™ Р В РЎвЂ”Р В РЎвЂў Р В РЎвЂР В РЎВР В Р’ВµР В Р вЂ¦Р В РЎвЂ Р РЋРЎвЂњР В Р’В·Р В Р’В»Р В Р’В°"""
	if object_name not in collected_pickups:
		collected_pickups.append(object_name)

	if RunState:
		RunState.mark_object_consumed(current_level, object_name, {
			"collected": true,
			"object_type": "pickup",
		})

func _get_current_level_object_state(object_name: String) -> Dictionary:
	if not RunState:
		return {}

	return RunState.get_object_state(current_level, object_name)


func _state_matches_object_type(state: Dictionary, expected_type: String) -> bool:
	if state.is_empty():
		return false

	return String(state.get("object_type", "")) == expected_type


func register_killed_enemy(enemy_name: String):
	"""Р В Р’В Р В Р’ВµР В РЎвЂ“Р В РЎвЂР РЋР С“Р РЋРІР‚С™Р РЋР вЂљР В РЎвЂР РЋР вЂљР РЋРЎвЂњР В Р’ВµР РЋРІР‚С™ Р РЋРЎвЂњР В Р’В±Р В РЎвЂР РЋРІР‚С™Р В РЎвЂўР В РЎвЂ“Р В РЎвЂў Р В Р вЂ Р РЋР вЂљР В Р’В°Р В РЎвЂ“Р В Р’В° Р В РЎвЂ”Р В РЎвЂў Р В РЎвЂР В РЎВР В Р’ВµР В Р вЂ¦Р В РЎвЂ Р РЋРЎвЂњР В Р’В·Р В Р’В»Р В Р’В°"""
	if enemy_name not in killed_enemies:
		killed_enemies.append(enemy_name)

	if RunState:
		RunState.mark_object_consumed(current_level, enemy_name, {
			"dead": true,
			"object_type": "enemy",
		})

func is_pickup_collected(object_name: String) -> bool:
	if object_name in collected_pickups:
		return true

	if RunState:
		var state: Dictionary = _get_current_level_object_state(object_name)
		if _state_matches_object_type(state, "pickup"):
			return bool(state.get("collected", false)) or bool(state.get("consumed", false))

	return false

func is_enemy_killed(enemy_name: String) -> bool:
	if enemy_name in killed_enemies:
		return true

	if RunState:
		var state: Dictionary = _get_current_level_object_state(enemy_name)
		if _state_matches_object_type(state, "enemy"):
			return bool(state.get("dead", false)) or bool(state.get("consumed", false))

	return false

func set_current_level(level_name: String):
	"""Р В Р в‚¬Р РЋР С“Р РЋРІР‚С™Р В Р’В°Р В Р вЂ¦Р В Р’В°Р В Р вЂ Р В Р’В»Р В РЎвЂР В Р вЂ Р В Р’В°Р В Р’ВµР РЋРІР‚С™ Р РЋРІР‚С™Р В Р’ВµР В РЎвЂќР РЋРЎвЂњР РЋРІР‚В°Р В РЎвЂР В РІвЂћвЂ“ Р РЋРЎвЂњР РЋР вЂљР В РЎвЂўР В Р вЂ Р В Р’ВµР В Р вЂ¦Р РЋР Р‰"""
	current_level = level_name
	if RunState:
		RunState.set_current_level(level_name)

func register_opened_chest(chest_name: String):
	"""Р В Р’В Р В Р’ВµР В РЎвЂ“Р В РЎвЂР РЋР С“Р РЋРІР‚С™Р РЋР вЂљР В РЎвЂР РЋР вЂљР РЋРЎвЂњР В Р’ВµР РЋРІР‚С™ Р В РЎвЂўР РЋРІР‚С™Р В РЎвЂќР РЋР вЂљР РЋРІР‚в„–Р РЋРІР‚С™Р РЋРІР‚в„–Р В РІвЂћвЂ“ Р РЋР С“Р РЋРЎвЂњР В Р вЂ¦Р В РўвЂР РЋРЎвЂњР В РЎвЂќ"""
	if current_level == "":
		current_level = "unknown"

	if current_level not in opened_chests:
		opened_chests[current_level] = []

	if chest_name not in opened_chests[current_level]:
		opened_chests[current_level].append(chest_name)

	if RunState:
		RunState.mark_object_consumed(current_level, chest_name, {
			"opened": true,
			"object_type": "chest",
		})

func is_chest_opened(chest_name: String) -> bool:
	"""Р В РЎСџР РЋР вЂљР В РЎвЂўР В Р вЂ Р В Р’ВµР РЋР вЂљР РЋР РЏР В Р’ВµР РЋРІР‚С™, Р В Р’В±Р РЋРІР‚в„–Р В Р’В» Р В Р’В»Р В РЎвЂ Р РЋР С“Р РЋРЎвЂњР В Р вЂ¦Р В РўвЂР РЋРЎвЂњР В РЎвЂќ Р РЋРЎвЂњР В Р’В¶Р В Р’Вµ Р В РЎвЂўР РЋРІР‚С™Р В РЎвЂќР РЋР вЂљР РЋРІР‚в„–Р РЋРІР‚С™ (Р В РЎвЂР РЋРІР‚В°Р В Р’ВµР В РЎВ Р В Р вЂ Р В РЎвЂў Р В Р вЂ Р РЋР С“Р В Р’ВµР РЋРІР‚В¦ Р РЋРЎвЂњР РЋР вЂљР В РЎвЂўР В Р вЂ Р В Р вЂ¦Р РЋР РЏР РЋРІР‚В¦)"""
	if RunState:
		if RunState.get_object_flag(current_level, chest_name, "opened"):
			return true
		if RunState.get_object_flag_any_level(chest_name, "opened"):
			return true

	for level in opened_chests.keys():
		if chest_name in opened_chests[level]:
			return true
	return false

func register_dropped_pickup(pickup_data: Dictionary):
	"""Р В Р’В Р вЂ™Р’В Р В Р’В Р вЂ™Р’ВµР В Р’В Р РЋРІР‚вЂњР В Р’В Р РЋРІР‚ВР В Р Р‹Р В РЎвЂњР В Р Р‹Р Р†Р вЂљРЎв„ўР В Р Р‹Р В РІР‚С™Р В Р’В Р РЋРІР‚ВР В Р Р‹Р В РІР‚С™Р В Р Р‹Р РЋРІР‚СљР В Р’В Р вЂ™Р’ВµР В Р Р‹Р Р†Р вЂљРЎв„ў Р В Р’В Р В РІР‚В Р В Р Р‹Р Р†Р вЂљРІвЂћвЂ“Р В Р’В Р РЋРІР‚вЂќР В Р’В Р вЂ™Р’В°Р В Р’В Р В РІР‚В Р В Р Р‹Р Р†РІР‚С™Р’В¬Р В Р’В Р РЋРІР‚ВР В Р’В Р Р†РІР‚С›РІР‚вЂњ Р В Р’В Р РЋРІР‚вЂќР В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’ВµР В Р’В Р СћРІР‚ВР В Р’В Р РЋР’ВР В Р’В Р вЂ™Р’ВµР В Р Р‹Р Р†Р вЂљРЎв„ў Р В Р’В Р СћРІР‚ВР В Р’В Р вЂ™Р’В»Р В Р Р‹Р В Р РЏ Р В Р’В Р В РІР‚В Р В Р’В Р РЋРІР‚СћР В Р Р‹Р В РЎвЂњР В Р Р‹Р В РЎвЂњР В Р Р‹Р Р†Р вЂљРЎв„ўР В Р’В Р вЂ™Р’В°Р В Р’В Р В РІР‚В¦Р В Р’В Р РЋРІР‚СћР В Р’В Р В РІР‚В Р В Р’В Р вЂ™Р’В»Р В Р’В Р вЂ™Р’ВµР В Р’В Р В РІР‚В¦Р В Р’В Р РЋРІР‚ВР В Р Р‹Р В Р РЏ Р В Р’В Р РЋРІР‚вЂќР В Р Р‹Р В РІР‚С™Р В Р’В Р РЋРІР‚В Р В Р’В Р В РІР‚В Р В Р’В Р РЋРІР‚СћР В Р’В Р вЂ™Р’В·Р В Р’В Р В РІР‚В Р В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’В°Р В Р Р‹Р Р†Р вЂљРЎв„ўР В Р’В Р вЂ™Р’Вµ
	pickup_data = {type: "item"/"artifact", id: int/String, position: Vector2}
	"""
	if current_level == "":
		current_level = "unknown"

	if current_level not in dropped_pickups:
		dropped_pickups[current_level] = []

	dropped_pickups[current_level].append(pickup_data)


func get_dropped_pickups_for_level(level_name: String) -> Array:
	"""Р В Р’В Р Р†Р вЂљРІвЂћСћР В Р’В Р РЋРІР‚СћР В Р’В Р вЂ™Р’В·Р В Р’В Р В РІР‚В Р В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’В°Р В Р Р‹Р Р†Р вЂљР’В°Р В Р’В Р вЂ™Р’В°Р В Р’В Р вЂ™Р’ВµР В Р Р‹Р Р†Р вЂљРЎв„ў Р В Р Р‹Р В РЎвЂњР В Р’В Р РЋРІР‚вЂќР В Р’В Р РЋРІР‚ВР В Р Р‹Р В РЎвЂњР В Р’В Р РЋРІР‚СћР В Р’В Р РЋРІР‚Сњ Р В Р’В Р В РІР‚В Р В Р Р‹Р Р†Р вЂљРІвЂћвЂ“Р В Р’В Р РЋРІР‚вЂќР В Р’В Р вЂ™Р’В°Р В Р’В Р В РІР‚В Р В Р Р‹Р Р†РІР‚С™Р’В¬Р В Р’В Р РЋРІР‚ВР В Р Р‹Р Р†Р вЂљР’В¦ Р В Р’В Р РЋРІР‚вЂќР В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’ВµР В Р’В Р СћРІР‚ВР В Р’В Р РЋР’ВР В Р’В Р вЂ™Р’ВµР В Р Р‹Р Р†Р вЂљРЎв„ўР В Р’В Р РЋРІР‚СћР В Р’В Р В РІР‚В  Р В Р’В Р СћРІР‚ВР В Р’В Р вЂ™Р’В»Р В Р Р‹Р В Р РЏ Р В Р Р‹Р РЋРІР‚СљР В Р Р‹Р В РІР‚С™Р В Р’В Р РЋРІР‚СћР В Р’В Р В РІР‚В Р В Р’В Р В РІР‚В¦Р В Р Р‹Р В Р РЏ"""
	if level_name in dropped_pickups:
		return dropped_pickups[level_name]
	return []


func remove_dropped_pickup(pickup_name: String):
	"""Р В Р’В Р В РІвЂљВ¬Р В Р’В Р СћРІР‚ВР В Р’В Р вЂ™Р’В°Р В Р’В Р вЂ™Р’В»Р В Р Р‹Р В Р РЏР В Р’В Р вЂ™Р’ВµР В Р Р‹Р Р†Р вЂљРЎв„ў Р В Р’В Р В РІР‚В Р В Р Р‹Р Р†Р вЂљРІвЂћвЂ“Р В Р’В Р РЋРІР‚вЂќР В Р’В Р вЂ™Р’В°Р В Р’В Р В РІР‚В Р В Р Р‹Р Р†РІР‚С™Р’В¬Р В Р’В Р РЋРІР‚ВР В Р’В Р Р†РІР‚С›РІР‚вЂњ Р В Р’В Р РЋРІР‚вЂќР В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’ВµР В Р’В Р СћРІР‚ВР В Р’В Р РЋР’ВР В Р’В Р вЂ™Р’ВµР В Р Р‹Р Р†Р вЂљРЎв„ў Р В Р’В Р РЋРІР‚ВР В Р’В Р вЂ™Р’В· Р В Р Р‹Р В РЎвЂњР В Р’В Р РЋРІР‚вЂќР В Р’В Р РЋРІР‚ВР В Р Р‹Р В РЎвЂњР В Р’В Р РЋРІР‚СњР В Р’В Р вЂ™Р’В° (Р В Р’В Р РЋРІР‚СњР В Р’В Р РЋРІР‚СћР В Р’В Р РЋРІР‚вЂњР В Р’В Р СћРІР‚ВР В Р’В Р вЂ™Р’В° Р В Р’В Р РЋРІР‚вЂќР В Р’В Р РЋРІР‚СћР В Р’В Р СћРІР‚ВР В Р’В Р РЋРІР‚СћР В Р’В Р вЂ™Р’В±Р В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’В°Р В Р’В Р В РІР‚В¦)"""
	if current_level in dropped_pickups:
		for i in range(dropped_pickups[current_level].size() - 1, -1, -1):
			var pickup = dropped_pickups[current_level][i]
			if pickup.get("name", "") == pickup_name:
				dropped_pickups[current_level].remove_at(i)
				return


func clear_dropped_pickups_for_level(level_name: String):
	"""Р В Р’В Р РЋРІР‚С”Р В Р Р‹Р Р†Р вЂљР Р‹Р В Р’В Р РЋРІР‚ВР В Р Р‹Р Р†Р вЂљР’В°Р В Р’В Р вЂ™Р’В°Р В Р’В Р вЂ™Р’ВµР В Р Р‹Р Р†Р вЂљРЎв„ў Р В Р’В Р В РІР‚В Р В Р Р‹Р Р†Р вЂљРІвЂћвЂ“Р В Р’В Р РЋРІР‚вЂќР В Р’В Р вЂ™Р’В°Р В Р’В Р В РІР‚В Р В Р Р‹Р Р†РІР‚С™Р’В¬Р В Р’В Р РЋРІР‚ВР В Р’В Р вЂ™Р’Вµ Р В Р’В Р РЋРІР‚вЂќР В Р Р‹Р В РІР‚С™Р В Р’В Р вЂ™Р’ВµР В Р’В Р СћРІР‚ВР В Р’В Р РЋР’ВР В Р’В Р вЂ™Р’ВµР В Р Р‹Р Р†Р вЂљРЎв„ўР В Р Р‹Р Р†Р вЂљРІвЂћвЂ“ Р В Р’В Р СћРІР‚ВР В Р’В Р вЂ™Р’В»Р В Р Р‹Р В Р РЏ Р В Р Р‹Р РЋРІР‚СљР В Р Р‹Р В РІР‚С™Р В Р’В Р РЋРІР‚СћР В Р’В Р В РІР‚В Р В Р’В Р В РІР‚В¦Р В Р Р‹Р В Р РЏ"""
	if level_name in dropped_pickups:
		dropped_pickups[level_name].clear()


func save_player_stats():
	if current_player:
		saved_player_health = current_player.current_health
		if "current_mana" in current_player:
			saved_player_mana = current_player.current_mana
		else:
			saved_player_mana = -1

		if "madness_stacks" in current_player:
			saved_player_madness_stacks = int(current_player.madness_stacks)
		else:
			saved_player_madness_stacks = 0

		if "max_madness_stacks" in current_player:
			saved_player_max_madness_stacks = int(current_player.max_madness_stacks)
		else:
			saved_player_max_madness_stacks = 9

func restore_player_stats():
	if current_player and saved_player_health > 0:
		current_player.current_health = saved_player_health

		if "current_mana" in current_player and saved_player_mana >= 0:
			current_player.current_mana = saved_player_mana

		if "max_madness_stacks" in current_player:
			current_player.max_madness_stacks = saved_player_max_madness_stacks
		if current_player.has_method("set_madness_stacks"):
			current_player.set_madness_stacks(saved_player_madness_stacks)

		if current_player.has_signal("health_changed"):
			current_player.health_changed.emit(current_player.current_health)
		if current_player.has_signal("mana_changed") and "current_mana" in current_player:
			current_player.mana_changed.emit(current_player.current_mana)

func clear_saved_stats():
	saved_player_health = -1
	saved_player_mana = -1
	saved_player_madness_stacks = 0
	saved_player_max_madness_stacks = 9

