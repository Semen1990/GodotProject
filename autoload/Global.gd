func set_revival_artifact(artifact_id: String):
	"""Р В Р в‚¬Р РЋР С“Р РЋРІР‚С™Р В Р’В°Р В Р вЂ¦Р В Р’В°Р В Р вЂ Р В Р’В»Р В РЎвЂР В Р вЂ Р В Р’В°Р В Р’ВµР РЋРІР‚С™ Р В Р’В°Р РЋР вЂљР РЋРІР‚С™Р В Р’ВµР РЋРІР‚С›Р В Р’В°Р В РЎвЂќР РЋРІР‚С™ Р В Р вЂ Р В РЎвЂўР В Р’В·Р РЋР вЂљР В РЎвЂўР В Р’В¶Р В РўвЂР В Р’ВµР В Р вЂ¦Р В РЎвЂР РЋР РЏ (Р В Р вЂ Р РЋРІР‚в„–Р В Р’В·Р РЋРІР‚в„–Р В Р вЂ Р В Р’В°Р В Р’ВµР РЋРІР‚С™Р РЋР С“Р РЋР РЏ Р В РЎвЂР В Р’В· level1.gd)"""
	revival_artifact_id = artifact_id


func get_revival_artifact() -> String:
	return revival_artifact_id


func has_revival_artifact() -> bool:
