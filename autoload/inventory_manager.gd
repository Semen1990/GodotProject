func is_potion_item(item: InventoryItem) -> bool:
	if item == null or item.data == null:
		return false

	return item.data.consumable_type in [
		InventoryEnums.ConsumableType.POTION_HP,
		InventoryEnums.ConsumableType.POTION_MANA,
		InventoryEnums.ConsumableType.POTION_BUFF,
	]


func is_buff_potion_item(item: InventoryItem) -> bool:
	if item == null or item.data == null:
		return false

	return item.data.consumable_type == InventoryEnums.ConsumableType.POTION_BUFF


func can_use_item_instance(item: InventoryItem) -> bool:
	if item == null or item.data == null:
		return false

	if not is_potion_item(item):
		return true

	return can_use_potion(item.get_item_id(), item.data)


func is_potion_blocked(item: InventoryItem) -> bool:
	if item == null or item.data == null:
		return false

	return not can_use_item_instance(item)


func can_use_potion(item_id: int, item_data: GameItemData = null) -> bool:
	if item_data == null:
		return not item_id in active_potion_buffs

	match item_data.consumable_type:
		InventoryEnums.ConsumableType.POTION_HP:
			return not bool(instant_potion_repeat_blocks.get("hp", false))
		InventoryEnums.ConsumableType.POTION_MANA:
			return not bool(instant_potion_repeat_blocks.get("mana", false))
		InventoryEnums.ConsumableType.POTION_BUFF:
			return not item_id in active_potion_buffs
		_:
			return true


func mark_potion_used(item_id: int, item_data: GameItemData = null, buff_data: Dictionary = {}):
	if item_data != null and item_data.consumable_type != InventoryEnums.ConsumableType.POTION_BUFF:
		return

	active_potion_buffs[item_id] = buff_data.duplicate(true)


func is_potion_used(item_id: int, item_data: GameItemData = null) -> bool:
	if item_data != null and item_data.consumable_type != InventoryEnums.ConsumableType.POTION_BUFF:
		return false

	return item_id in active_potion_buffs


func clear_potion_effects() -> void:
	used_potions_this_room.clear()
	active_potion_buffs.clear()
	_notify_potion_block_state_changed()


func clear_instant_potion_repeat_blocks() -> void:
	if instant_potion_repeat_blocks.is_empty():
		return

	instant_potion_repeat_blocks.clear()
	_notify_potion_block_state_changed()


func set_instant_potion_repeat_block(potion_kind: String, blocked: bool) -> void:
	var previous_value: bool = bool(instant_potion_repeat_blocks.get(potion_kind, false))
	if previous_value == blocked:
		return

	if blocked:
		instant_potion_repeat_blocks[potion_kind] = true
	else:
		instant_potion_repeat_blocks.erase(potion_kind)

	_notify_potion_block_state_changed()


func _notify_potion_block_state_changed() -> void:
	inventory_changed.emit()
	for i in range(HOTBAR_SLOTS):
